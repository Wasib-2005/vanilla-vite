{
  "name": "create-vanilla-vite",
  "version": "1.2.2",
  "description": "Scaffold a React or Vite app with an optional Node.js or Express backend",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wasib-2005/vanilla-vite.git"
  },
  "homepage": "https://github.com/Wasib-2005/vanilla-vite#readme",
  "bugs": {
    "url": "https://github.com/Wasib-2005/vanilla-vite/issues"
  },
  "bin": {
    "create-vanilla-vite": "./bin/create-template.mjs"
  },
  "files": [
    "bin/",
    "scripts/dev.mjs",
    "scripts/run-app.mjs",
    "scripts/install-info.mjs",
    "scripts/add-dependency.mjs",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node test/fixes.test.mjs && node test/version-manager.test.mjs && node test/smoke.mjs --quick",
    "test:unit": "node test/fixes.test.mjs && node test/version-manager.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "vpublish": "node scripts/version-manager.mjs"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.6"
  },
  "keywords": [
    "create",
    "create-vite",
    "react",
    "vite",
    "scaffold",
    "generator",
    "starter",
    "fullstack",
    "full-stack",
    "monorepo",
    "pnpm",
    "npm",
    "node",
    "nodejs",
    "express",
    "typescript",
    "javascript",
    "cli"
  ],
  "license": "ISC",
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
